# Smile Classifier - Inference Notebook
# This notebook demonstrates how to use the trained model for inference

# ## 1. Setup and Imports
import numpy as np
import pickle
from PIL import Image

# ## 2. Load Model
def load_model(model_path='smile_classifier.pkl'):
    with open(model_path, 'rb') as f:
        model = pickle.load(f)
    return model

model = load_model()
print("Model loaded successfully")

# ## 3. Preprocess Image
def preprocess_image(image_path, img_size=(64, 64)):
    img = Image.open(image_path).convert('L')  # Convert to grayscale
    img = img.resize(img_size)
    img_array = np.array(img).flatten().reshape(1, -1) / 255.0
    return img_array

# ## 4. Predict
def predict(image_path, model):
    img_array = preprocess_image(image_path)
    prediction = model.predict(img_array)[0]
    proba = model.predict_proba(img_array)[0]
    confidence = max(proba)
    label = "smiling" if prediction == 1 else "not_smiling"
    return label, confidence

